<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<dictionary title="Ganpi" xmlns:xi="http://www.w3.org/2003/XInclude">
    <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>

    <suite name="Ganpi Suite" code="Ganp" description="Ganpi-specific classes.">
        
        <enumeration name="saveable file format" code="savf">
            <enumerator name="Text" code="TXT " description="The plain text.">
                <cocoa string-value="public.data"/>
            </enumerator>
        </enumeration>
        
        <enumeration name="character code" code="Genc">
            <enumerator name="UTF8" code="Guf8" description="UTF-8"/>
            <enumerator name="UTF16" code="Gu16" description="UTF-16"/>
            <enumerator name="UTF32" code="Gu32" description="UTF-32"/>
            <enumerator name="JIS" code="Gjis" description="ISO-2022-JP"/>
            <enumerator name="SJIS" code="Gsjs" description="Shift JIS"/>
            <enumerator name="EUC" code="Geuc" description="EUC-JP"/>
        </enumeration>

        <enumeration name="return code" code="Gret">
            <enumerator name="LF" code="Grlf" description="LF"/>
            <enumerator name="CR" code="Grcr" description="CR"/>
            <enumerator name="CRLF" code="Gcrl" description="CRLF"/>
        </enumeration>
        
        <command name="search" code="GanpSrch" description="Searches text in a document and returns all matched ranges.">
            <direct-parameter type="document" description="The document to search."/>
            <parameter name="for" code="Gfor" type="text" description="The search string.">
                <cocoa key="targetString"/>
            </parameter>
            <parameter name="case sensitive" code="Gcas" type="boolean" optional="yes" description="Whether the search is case-sensitive.">
                <cocoa key="caseSensitive"/>
            </parameter>
            <parameter name="regular expression" code="Greg" type="boolean" optional="yes" description="Whether the search string is a regular expression.">
                <cocoa key="regularExpression"/>
            </parameter>
            <result type="any" description="A list of {location, length} pairs."/>
        </command>

        <command name="replace" code="GanpRplc" description="Replaces all matched text in a document.">
            <direct-parameter type="document" description="The document to modify."/>
            <parameter name="for" code="Gfor" type="text" description="The search string.">
                <cocoa key="targetString"/>
            </parameter>
            <parameter name="with" code="Gwth" type="text" description="The replacement string.">
                <cocoa key="replacementString"/>
            </parameter>
            <parameter name="case sensitive" code="Gcas" type="boolean" optional="yes" description="Whether the search is case-sensitive.">
                <cocoa key="caseSensitive"/>
            </parameter>
            <parameter name="regular expression" code="Greg" type="boolean" optional="yes" description="Whether the search string is a regular expression.">
                <cocoa key="regularExpression"/>
            </parameter>
            <result type="integer" description="The number of replacements."/>
        </command>
        
        <command name="perform user macro" code="GanpPUMc" description="Performs a user macro on the active text view.">
            <cocoa class="GanpiPerformUserMacroCommand"/>
            <direct-parameter type="text" description="The user macro sequence to perform."/>
            <result type="boolean" description="Did the user macro run?"/>
        </command>

        <class-extension extends="document" description="A Ganpi document.">
            <cocoa class="Ganpi.Document"/>
            
            <responds-to command="search">
                <cocoa method="handleSearchScriptCommand:"/>
            </responds-to>

            <responds-to command="replace">
                <cocoa method="handleReplaceScriptCommand:"/>
            </responds-to>
            
            <property name="syntax types" code="Gsts" access="r" description="The available syntax types for the document.">
                <cocoa key="scriptSyntaxTypes"/>
                <type type="text" list="yes"/>
            </property>
            
            <property name="font name" code="Gfnm" type="text" access="rw" description="The font name used to display the document.">
                <cocoa key="scriptFontName"/>
            </property>

            <property name="font size" code="Gfsz" type="real" access="rw" description="The font size used to display the document.">
                <cocoa key="scriptFontSize"/>
            </property>

            <property name="line spacing" code="Glns" type="real" access="rw" description="The line spacing of the visible document view.">
                <cocoa key="scriptLineSpacing"/>
            </property>

            <property name="text" code="ctxt" type="text" access="rw" description="The plain text contents of the document.">
                <cocoa key="scriptText"/>
            </property>

            <property name="character code" code="Gcoc" type="character code" access="rw" description="The character encoding used when saving the document.">
                <cocoa key="scriptCharacterCode"/>
            </property>

            <property name="return code" code="Grtc" type="return code" access="rw" description="The line ending used when saving the document.">
                <cocoa key="scriptReturnCode"/>
            </property>
            
            <property name="syntax type" code="Gsyt" type="text" access="rw" description="The syntax type of the document.">
                <cocoa key="scriptSyntaxType"/>
            </property>
            
        </class-extension>
    </suite>
</dictionary>
